;; programs/lint_commit.lip -- a commit-message linter.

(define (subject-ok? s)
  (and (not (string-blank? s))
       (<= (string-length s) 50)
       (not (= (string-slice s (- (string-length s) 1) (string-length s)) "."))))

(define (line-ok? s)
  (<= (string-length s) 72))

(define (lint text)
  (let lines (string-split text "\n")
    (let subject (list-ref lines 0)
      (cond [(not (subject-ok? subject)) (err 'bad-subject)]
            [(and (> (length lines) 1)
                  (not (string-blank? (list-ref lines 1))))
             (err 'missing-blank-line)]
            [else
             (let bad (filter (fn [l] (not (line-ok? l))) (rest (rest lines)))
               (if (= (length bad) 0)
                 (ok nil)
                 (err 'line-too-long)))]))))

(assert (ok? (lint "Add x\n\nbody.\n")) "good message accepted")
(assert (err? (lint "added x.\nno blank\n")) "bad message rejected")

(let path (if (nil? (env "BLIP_LINT_FILE")) "COMMIT_EDITMSG" (env "BLIP_LINT_FILE"))
  (if (file-exists? path)
    (let msg (ok-value (read-file path))
      (let r (lint msg)
        (if (err? r)
          (raise (err (err-value r)))
          (print "lint ok"))))
    (print "lint ok")))
